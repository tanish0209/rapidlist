generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Task{
  id String @id @default(cuid())
  title String 
  description String?
  dueDate DateTime?
  priority Priority @default(Medium)
  status Status @default(To_Do)
  createdAt DateTime @default(now())

}
enum Priority{
  Low
  Medium
  High
}
enum Status{
  To_Do
  In_Progress
  Done
}